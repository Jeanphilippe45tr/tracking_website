# -------------------------------------------------------------------
# Client environment variables (Vite)
# Copy this file to ".env" and adjust the values.
# Only variables prefixed with VITE_ are exposed to the browser code.
# -------------------------------------------------------------------

# ---------------- API connection ----------------
# "true"  -> the app runs with the built-in mock data (no server needed)
# "false" -> every API call hits the real backend (server/ folder)
VITE_USE_MOCK=false

# Base URL of the backend API (no trailing slash).
# Local dev backend: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# ---------------- Brand / contact info ----------------
# Optional overrides for the marketing pages, navbar and chat widget.
# Any key left empty falls back to the built-in default in src/data/site.js.

# Display name of the company.
VITE_BRAND_NAME=SwiftTrack

# Support email shown on the contact page and in the chat footer.
VITE_SUPPORT_EMAIL=support@swifttrack.com

# Phone number, as it should be displayed (e.g. "+1 (212) 555-0142").
# The tel: link is derived from this value automatically.
VITE_SUPPORT_PHONE=+1 (212) 555-0142

# WhatsApp number, digits WITH country code, plus sign optional
# (used to build the wa.me link on the contact page).
VITE_WHATSAPP_NUMBER=12125550142

# ---------------- Notes ----------------
# ".env" is ignored by git (see .gitignore) — never commit secrets.
# The app itself holds no secrets in the browser: admin auth uses a JWT
# issued by the server and kept in localStorage.
