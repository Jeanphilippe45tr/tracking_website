# -------------------------------------------------------------------
# Server configuration
# Copy this file to .env and adjust the values.
# -------------------------------------------------------------------

PORT=5000

# -------------------------------------------------------------------
# Database - option A: one connection string (easiest on free hosts)
# -------------------------------------------------------------------
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=mysql://user:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/tracking_db
# Railway also provides MYSQL_URL / MYSQLHOST / MYSQLUSER / MYSQLPASSWORD /
# MYSQLDATABASE / MYSQLPORT. Those are picked up automatically.
# Set this to true when the provider requires TLS (TiDB, Aiven, ...).
# DB_SSL=true

# -------------------------------------------------------------------
# Database - option B: individual values (XAMPP defaults shown)
# Used when DATABASE_URL is empty.
# -------------------------------------------------------------------
DB_NAME=tracking_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_SSL=false

# Signing key for admin JWTs. Generate a long random value for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# "*" allows every origin. For production use a comma-separated list:
# CORS_ORIGIN=https://swifttrack.com,https://admin.swifttrack.com
CORS_ORIGIN=*

# Automatically insert demo data into an empty database on start.
SEED_ON_START=true

# Automatically create missing tables on start.
SYNC_DATABASE=true

# -------------------------------------------------------------------
# Address lookup (free OpenStreetMap Nominatim)
# -------------------------------------------------------------------
# No API key is needed. Set GEOCODE_ENABLED=false to skip network lookups
# and use only the built-in city list. Nominatim requires a User-Agent
# that identifies your app and a contact address.
GEOCODE_ENABLED=true
GEOCODE_URL=https://nominatim.openstreetmap.org/search
GEOCODE_USER_AGENT=SwiftTrack/1.0 (you@example.com)
# Keep at least 1000-1100ms between requests.
GEOCODE_MIN_INTERVAL_MS=1100
GEOCODE_TIMEOUT_MS=5000
