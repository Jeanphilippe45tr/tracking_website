# Server environment
PORT=5000

# Database (MySQL is the default dialect)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_NAME=tracking_db
DB_USER=root
DB_PASSWORD=

# For a zero-setup dev database instead:
# DB_DIALECT=sqlite
# DB_STORAGE=./data/tracking.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Seed admin account (created on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Security — comma-separated list of allowed frontend origins
# (leave unset for local dev => all origins allowed)
ALLOWED_ORIGIN=

# Public URL of the frontend — used to build tracking/unsubscribe links
# APP_URL=https://your-frontend.onrender.com

# Email sending (notifications, chat/contact alerts)
# Leave SMTP_HOST empty to run in log mode (emails print to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SwiftTrack <no-reply@swifttrack.com>
