# Server environment
PORT=5000

# Database (MySQL is the default dialect)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_NAME=tracking_db
DB_USER=root
DB_PASSWORD=

# For a zero-setup dev database instead:
# DB_DIALECT=sqlite
# DB_STORAGE=./data/tracking.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Seed admin account (created on first boot)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
